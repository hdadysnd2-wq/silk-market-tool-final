# ---------------------------------------------------------------------------
# Silk Export Intelligence — environment configuration
#
# Every vendor key below is OPTIONAL. When a key is blank the platform selects
# the deterministic mock adapter for that provider, so the entire application
# runs end to end with no external accounts. Set a key to activate the real
# adapter for that one provider; the rest keep using mocks.
# ---------------------------------------------------------------------------

# Core
ENVIRONMENT=local
# Outside ENVIRONMENT=local the sending/mailbox slots fail closed when no real
# provider is configured (a mock "send" marks the row sent while reaching
# nobody). ALLOW_MOCK_SENDING=1 is the explicit keyless-demo escape hatch.
#ALLOW_MOCK_SENDING=0
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
# Session-cookie Secure attribute (web). Empty => follows NODE_ENV (Secure in
# production). Browsers DROP a Secure cookie served over plain HTTP (except on
# localhost), which turns login into a silent redirect loop — set COOKIE_SECURE=0
# only if you must serve the app over plain HTTP (e.g. a bare-IP staging box).
COOKIE_SECURE=
DATABASE_URL=postgresql+psycopg://silk:silk@postgres:5432/silk
REDIS_URL=redis://redis:6379/0
# Number of trusted reverse proxies in front of the API (Railway edge = 1). When
# > 0, the real client IP is read from X-Forwarded-For for the per-IP auth
# throttles; 0 (local/CI) trusts only the direct peer. Behind a proxy, leaving
# this 0 makes every client share the proxy IP → 20 junk logins lock out everyone.
TRUSTED_PROXY_COUNT=0
API_BASE_URL=http://localhost:8000
# APP_BASE_URL = the EXACT origin users load the web app from in the browser
# (scheme + host, e.g. https://app.example.com). It builds email/OAuth links AND
# is trusted for the cookie-CSRF Origin check, so it must match the real browser
# origin. Outside local a localhost value is rejected at startup.
APP_BASE_URL=http://localhost:3000
# Browser origins allowed to call the API cross-site AND to pass the cookie-CSRF
# check. A state-changing request (add product, run research, …) whose browser
# Origin is not trusted 403s with "Cross-origin request blocked" — while reads
# (GET) still work. APP_BASE_URL is always trusted on top of this list, so if the
# app is on a custom domain, set APP_BASE_URL to it (and/or add it here). Values
# are canonicalized: a trailing slash, uppercase host, or explicit :443/:80 still
# match; scheme is significant (http ≠ https). Put the EXACT origin from the
# browser address bar — a mismatched host/scheme is the #1 cause of this error;
# the API logs `csrf_origin_blocked` with the rejected origin + allowlist. In
# local, localhost / 127.0.0.1 / [::1] are interchangeable. Outside local a
# wildcard or empty value is rejected at startup (credentialed CORS hole).
CORS_ORIGINS=http://localhost:3000

# Storage — "local" writes to ./storage, "s3" uses the MinIO/S3 settings below.
# Multi-container deploys (separate api + worker) MUST use "s3": a local file://
# image the api writes is invisible to the worker's vision pass. Set
# REQUIRE_OBJECT_STORAGE=1 there so a local misconfig fails loudly at startup.
STORAGE_BACKEND=s3
REQUIRE_OBJECT_STORAGE=0
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=silk-products
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=me-south-1
STORAGE_LOCAL_DIR=./storage

# LLM (vision HS classification + email drafting). Blank => MockLLMProvider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5

# Trade data. UN Comtrade is keyless; the key raises rate limits only. The key
# also gates the world_trade Stage-1 coverage sync (app.workers.tasks.
# sync_world_trade / refresh_world_trade): with COMTRADE_OFFLINE=1 or no key, the
# sync is fail-closed and the world funnel fails loudly on missing coverage
# rather than presenting demo/empty data as a real world screen.
COMTRADE_API_KEY=
# Set to 1 to force committed fixtures (CI / hermetic tests). Defaults to 0:
# keyless deploys are still offline in practice (keyless implies fixtures and
# the coverage sync is fail-closed without a key), so the only effect of the
# 0 default is that adding COMTRADE_API_KEY is sufficient to go live — no
# second flag to forget (audit 2026-08-07 C1).
COMTRADE_OFFLINE=0

# Observed competitor prices (paid, deepen-gated). Blank => MockPriceProvider
# (deterministic, offline). A value selects the LIVE LocalPriceProvider AND is the
# key the engine's LocalPriceAgent reads — set this ONE var to enable live prices.
# LOCALPRICE_API_URL points at the shopping/price API (e.g. a SerpApi endpoint).
LOCALPRICE_API_KEY=
# Engine importer-intel agents (additional buyer sources; Wave 3). Blank =>
# unregistered. Even with a key, calls run only inside a deepen scope (paid).
# VOLZA_API_KEY also flips the company-level shipments slot live
# (providers/shipments/volza.py) — keyless prod declares the customs step a gap.
# VOLZA_API_URL overrides the data-API base URL when the plan's endpoint differs.
VOLZA_API_KEY=
VOLZA_API_URL=
EXPLEE_API_KEY=
LOCALPRICE_API_URL=

# Stage-2 market enrichment (applied tariff + PPP). Set to 1 to select the LIVE
# World Bank / WITS adapter; blank/0 keeps the deterministic mock (offline / CI).
MARKET_ENRICHMENT_LIVE=0

# Firmographic enrichment. Blank => MockEnrichmentProvider.
CORESIGNAL_API_KEY=

# Long-tail buyer discovery via Google Maps data. Blank => MockMapsProvider.
OUTSCRAPER_API_KEY=

# Email finding waterfall. Blank => MockEmailFinderProvider.
APOLLO_API_KEY=

# Email verification. Blank => MockEmailVerifier.
ZEROBOUNCE_API_KEY=

# Cold-email sending infrastructure. Blank => MockSendingProvider.
# Cold email is NEVER sent through SendGrid/SES directly — only Smartlead/Instantly.
SMARTLEAD_API_KEY=
SMARTLEAD_WEBHOOK_SECRET=
# Fail-closed gate on the Smartlead slot. The one-click List-Unsubscribe headers
# are emitted by the Smartlead campaign SEQUENCE TEMPLATE from the adapter's
# custom fields — a console step no test can prove. With the key set but this
# flag off, the platform refuses every Smartlead send (the queued email stays
# queued). Set to 1 only after you have configured that template and checked it
# against a real account. See docs/PHASE3_ADAPTER_READINESS.md.
SMARTLEAD_SEQUENCE_VERIFIED=0

# ---------------------------------------------------------------------------
# Per-tenant mailbox OAuth (multi-tenant email sending)
#
# Each factory connects its own Gmail / Microsoft mailbox; the platform sends on
# that account's behalf. Blank client id/secret => the deterministic mock mailbox
# adapter (the whole connect→verify→send→reply flow still runs end to end).
# ---------------------------------------------------------------------------

# Fernet key (url-safe base64, 32 bytes) encrypting OAuth tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Blank is allowed ONLY when ENVIRONMENT=local (derived from SECRET_KEY for
# dev/CI); any other environment refuses to start without an explicit key.
TOKEN_ENCRYPTION_KEY=

# Google OAuth app (Gmail API — scopes: gmail.send + gmail.readonly). Blank => mock.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft OAuth app (Graph — scopes: Mail.Send + Mail.Read). Blank => mock.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common

# Where providers redirect after consent. Blank => derived from API_BASE_URL.
OAUTH_REDIRECT_BASE_URL=
# Frontend page the callback returns the browser to once a mailbox connects.
OAUTH_POST_CONNECT_PATH=/onboarding/email
OAUTH_STATE_TTL_MINUTES=15

# New connected mailboxes ramp from ~15/day up to this ceiling during warm-up.
SENDER_DEFAULT_DAILY_LIMIT=50
# How far back the reply-detection beat looks when first polling a mailbox.
REPLY_POLL_LOOKBACK_MINUTES=120

# Observability. Blank => Sentry disabled.
SENTRY_DSN=

# Deliverability guardrails (spec-mandated defaults)
MAX_EMAILS_PER_INBOX_PER_DAY=50
WARMUP_DAYS=14
BOUNCE_RATE_PAUSE_THRESHOLD=0.05
COMPLAINT_RATE_PAUSE_THRESHOLD=0.001
