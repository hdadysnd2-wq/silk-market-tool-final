# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.coverage
htmlcov/
build/
dist/

# Node
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo

# Playwright
playwright-report/
test-results/
apps/web/playwright/.cache/

# Env & secrets — ignore every .env* except the committed example
.env
.env.*
!.env.example

# Local runtime artifacts
storage/
outbox/
*.log
*.sqlite
*.db
.cache/
# engine local caches / traces (replaced by Postgres+Redis in Phase 1)
packages/silk_intel/silk_intel/data/cache/
packages/silk_intel/silk_intel/data/traces/

# Terraform — ignore state and any secret-bearing var files; the provider lock
# (.terraform.lock.hcl) is intentionally committed for reproducible provider hashes.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json

# OS
.DS_Store

# Redis persistence dumps from local dev/test servers
**/dump.rdb
